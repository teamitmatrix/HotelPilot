# Paths are relative to the PMS workspace root (pms/). Absolute OS-native
# paths also work. Avoid hardcoding /home/... so the same file works on Windows.
ERPCLAW_HOME=data
DATA_DIR=data
ERPCLAW_ENGINE_PATH=erpclaw-engine
WEBCLAW_ENV=development

# ── Database (platform + ERP require PostgreSQL) ────────────────────────────
# WebClaw (auth/sessions/plans/billing/audit/tickets) → schema ``webclaw``.
# ERP / hospitality (pms_tenant, rooms, reservations, folios, …) → schema ``public``.
# Startup fails unless DB_TYPE=postgres. SQLite is not a supported runtime.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms
DB_USER=postgres
DB_PASSWORD=
# Tenant isolation: skill DBs use Postgres RLS (app.tenant_id GUCs) plus SQL
# rewrite as defense-in-depth. Superusers bypass RLS — use a non-superuser
# DB_USER in production so FORCE ROW LEVEL SECURITY is effective.

# Optional full URL (wins over DB_* when set):
# WEBCLAW_DB_URL=postgresql://postgres@localhost:5432/pms
# ERPCLAW_DB_URL=postgresql://postgres@localhost:5432/pms

# Optional backup directory (default: DATA_DIR/backups).
# Platform snapshots: pg_dump --schema=webclaw
# ERP backups (erpclaw backup-database): pg_dump --schema=public
# WEBCLAW_BACKUP_DIR=data/backups

# ── Cutover (Step 7) ────────────────────────────────────────────────────────
# Runtime is Postgres-only. Do not set WEBCLAW_DB_PATH / ERPCLAW_DB_PATH for
# the API. After verify, archive any leftover .sqlite under:
#   data/sqlite_archive/<YYYYMMDD>/   (see RETENTION.md there)
# Keep migrate/verify scripts in-repo for one-off imports:
#   python webclaw/scripts/migrate_platform_sqlite_to_postgres.py --init-schema
#   python webclaw/scripts/migrate_erp_sqlite_to_postgres.py --init-schema
#   python erpclaw-engine/scripts/verify_sqlite_to_postgres.py
#   python webclaw/scripts/ci_grep_no_sqlite_runtime.py
# Optional archive paths for re-verify only:
# WEBCLAW_DB_PATH=data/sqlite_archive/<YYYYMMDD>/webclaw.sqlite
# ERPCLAW_DB_PATH=data/sqlite_archive/<YYYYMMDD>/data.sqlite

# ── Local DX / tests (PostgreSQL 18 on localhost) ───────────────────────────
#   DB_NAME=pms python erpclaw-engine/scripts/init_postgres.py
#   DB_NAME=pms_test python erpclaw-engine/scripts/init_postgres.py
#   cd webclaw/api && pytest
#   python webclaw/scripts/ci_grep_no_sqlite_runtime.py
# WEBCLAW_TEST_DB=pms_test

# ── AI Assistant multi-LLM routing ──────────────────────────────────────────
# Task buckets:
#   PRIMARY   → fast lookup / simple Q&A / SQL extraction
#   ANALYTICS → analytical queries & data summaries
#   REPORT    → structured reports / long-context summarization
#   FALLBACK  → used when the selected provider fails or rate-limits
#
# Providers: openai | anthropic | gemini
# Recommended cost/quality mix:
# PRIMARY_LLM_PROVIDER=gemini
# PRIMARY_LLM_MODEL=gemini-2.0-flash
# ANALYTICS_LLM_PROVIDER=openai
# ANALYTICS_LLM_MODEL=gpt-4o
# REPORT_LLM_PROVIDER=anthropic
# REPORT_LLM_MODEL=claude-3-5-sonnet-20241022
# FALLBACK_LLM_PROVIDER=openai
# FALLBACK_LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=4096
#
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Platform SaaS Stripe (optional — also configurable in SuperAdmin → Integrations)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Guest messaging (optional — also SuperAdmin → Integrations)
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@hotel.test
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# TWILIO_WHATSAPP_FROM=whatsapp:+1...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# WEBCLAW_NOTIFY_POLL_SECONDS=900
# WEBCLAW_NOTIFY_SCHEDULER=1
