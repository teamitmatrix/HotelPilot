# Paths relative to the PMS workspace root (pms/). Works on Windows and Unix.
ERPCLAW_HOME=data
DATA_DIR=data

# Database (PostgreSQL only)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms
DB_USER=postgres
DB_PASSWORD=

# Legacy SQLite — migrate/verify only (archives under data/sqlite_archive/):
# ERPCLAW_DB_PATH=data/sqlite_archive/<YYYYMMDD>/data.sqlite
